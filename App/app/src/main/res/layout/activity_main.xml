<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/gui_TextView"
        android:layout_width="1000px"
        android:layout_height="1000px"
        android:textSize="100"
        android:text="1000"/>

    <FrameLayout
        android:id="@+id/gui_FrameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/gui_BottomNavigationView" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/gui_BottomNavigationView"
        android:layout_width="match_parent"

        android:layout_height="70dp"
        android:layout_alignParentBottom="true"

        android:background="@color/colorPrimaryDark"
        app:itemActiveIndicatorStyle="@android:color/transparent"

        app:itemIconTint="@color/bottom_navigation_bar_selector"
        app:itemTextColor="@color/bottom_navigation_bar_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu" />

</RelativeLayout>