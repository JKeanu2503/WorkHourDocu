<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_default_icon_design"
    android:layout_margin="@dimen/dimen_Margin_ElementEdge_Default"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/gui_ImageView_Dashboard_Icon"
        android:layout_width="@dimen/dimen_ImageSize_Dashboard_Default"
        android:layout_height="@dimen/dimen_ImageSize_Dashboard_Default"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_toRightOf="@id/gui_ImageView_Dashboard_Icon"
        android:layout_marginLeft="@dimen/dimen_Margin_ElementDistance_Default"
        android:gravity="center">

        <TextView
            android:id="@+id/gui_TextView_Dashboard_ElementTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test Title"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="@dimen/dimen_TextSize_Dashboard_Element_Title"/>

        <TextView
            android:id="@+id/gui_TextView_Dashboard_ElementValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test Value"
            android:textColor="@color/color_BLUE"
            android:textSize="@dimen/dimen_TextSize_Dashboard_Element_Value"/>

    </LinearLayout>

</RelativeLayout>